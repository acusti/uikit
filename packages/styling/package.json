{
    "name": "@acusti/styling",
    "version": "2.1.5",
    "description": "React stylesheets from CSS imports, server-rendered with their text and left out of the client bundle (React 19 + Vite)",
    "keywords": [
        "css",
        "react",
        "react-component",
        "ssr",
        "styles",
        "ts",
        "typescript",
        "vite",
        "vite-plugin"
    ],
    "homepage": "https://github.com/acusti/uikit/tree/main/packages/styling#readme",
    "bugs": {
        "url": "https://github.com/acusti/uikit/issues"
    },
    "license": "Unlicense",
    "author": "andrew patton <andrew@acusti.ca> (https://www.acusti.ca)",
    "repository": {
        "type": "git",
        "url": "https://github.com/acusti/uikit.git",
        "directory": "packages/styling"
    },
    "files": [
        "client.d.ts",
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./dist/vite.js"
        },
        "./client": {
            "types": "./client.d.ts"
        }
    },
    "scripts": {
        "test": "vitest",
        "build": "vite build && tsc -p tsconfig.build.json",
        "tsc": "tsc --noEmit"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.1.0",
        "@types/react": "^19.3",
        "@types/react-dom": "^19.3",
        "happy-dom": "^21.0.4",
        "react": "^19.3",
        "react-dom": "^19.3",
        "typescript": "^7",
        "vite": "^8.0.0-0",
        "vitest": "^5"
    },
    "peerDependencies": {
        "react": "^19.2",
        "react-dom": "^19.2",
        "vite": ">=6.0.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    }
}
