{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(git commit --amend *)",
            "Bash(git push --force-with-lease --force-if-includes origin claude/*)"
        ],
        "ask": [
            "Bash(git push --force-with-lease --force-if-includes origin claude/* *)",
            "Bash(git push --force-with-lease --force-if-includes origin claude/*:**)"
        ]
    }
}
